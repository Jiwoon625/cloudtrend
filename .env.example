### TrendScore KR 환경변수 예시 (실제 값은 .env 에 저장하고 커밋하지 않습니다)

# 데이터 공급자 선택: mock | krx | provider-name
DATA_PROVIDER=mock

# 가격/재무 데이터 공급자 자격증명 (서버 전용, 프론트엔드에 노출 금지)
PRICE_PROVIDER_BASE_URL=
PRICE_PROVIDER_API_KEY=
FINANCIAL_PROVIDER_BASE_URL=
FINANCIAL_PROVIDER_API_KEY=

# 전략/데이터 버전 태그 (계산 로그 재현용)
STRATEGY_VERSION=1.0.0
DATA_VERSION=mock-2026-08-31

# 선택: 배치 스케줄러 및 캐시
CRON_SECRET=
REDIS_URL=

# 브라우저에 노출되어도 안전한 공개 설정만 VITE_ 접두사를 사용합니다
VITE_APP_NAME=TrendScore KR
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 신뢰된 CLI/GitHub Actions 전용. VITE_ 접두사를 붙이거나 브라우저에 넣지 않습니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_USER_ID=
